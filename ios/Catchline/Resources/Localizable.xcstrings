    "Subscriptions aren’t available right now.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الاشتراكات غير متاحة حاليًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Abos sind gerade nicht verfügbar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las suscripciones no están disponibles ahora mismo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les abonnements ne sont pas disponibles pour le moment."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अभी सब्सक्रिप्शन उपलब्ध नहीं हैं।"
          }
        },
        "id": {
          "stringUnit": {

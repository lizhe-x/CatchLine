    "You can export them first.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكنك تصديرها أولًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kannst sie vorher exportieren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes exportarlos primero."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez d’abord les exporter."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप पहले इन्हें एक्सपोर्ट कर सकते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamu bisa mengekspornya dulu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Puoi esportarli prima."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "先に書き出すこともできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "먼저 내보낼 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você pode exportá-las antes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сначала их можно экспортировать."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Önce dışa aktarabilirsiniz."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn có thể xuất trước."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可以先导出再开始。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "可以先匯出再開始。"
          }
        }
      }
    },
    "Your purchase is pending approval. It will activate automatically.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عملية الشراء بانتظار الموافقة، وستُفعَّل تلقائيًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Kauf wartet auf Genehmigung. Er wird automatisch aktiviert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu compra está pendiente de aprobación. Se activará automáticamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre achat est en attente d’approbation. Il s’activera automatiquement."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपकी ख़रीदारी अनुमोदन की प्रतीक्षा में है। यह अपने-आप सक्रिय हो जाएगी।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pembelianmu menunggu persetujuan. Akan aktif otomatis."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo acquisto è in attesa di approvazione. Si attiverà automaticamente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "購入は承認待ちです。承認されると自動的に有効になります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "구입이 승인 대기 중입니다. 승인되면 자동으로 활성화됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua compra está aguardando aprovação. Ela será ativada automaticamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Покупка ожидает подтверждения и активируется автоматически."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Satın alımınız onay bekliyor. Otomatik olarak etkinleşecek."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giao dịch mua đang chờ phê duyệt và sẽ tự động kích hoạt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "购买正在等待批准，批准后会自动生效。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "購買正在等待核准，核准後會自動生效。"
          }
        }
      }

          }
        }
      }
    },
    "Subscriptions aren’t available right now.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂时无法加载订阅。"
          }
        }
      }
    },
    "Subscriptions include 40 hours a month (fair use; normal use won’t reach it). The free trial includes 3 hours. Subscriptions renew automatically unless cancelled at least 24 hours before the end of the current period in Settings → Apple Account → Subscriptions.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "订阅含每月 40 小时（合理使用，正常使用基本不会达到）。免费试用期内含 3 小时。订阅会自动续期，可随时在 设置 → Apple 账户 → 订阅 中取消，需在当期结束前至少 24 小时取消。"
          }
        }
      }
    },
    "Terms of Use": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用条款"
          }
        }
      }
    },
    "The microphone is in use by the system (e.g. a call). Captions resume automatically afterwards.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "麦克风被系统占用（例如来电），结束后会自动继续"
          }
        }
      }
    },
    "This device doesn’t support App Attest": {
      "localizations": {

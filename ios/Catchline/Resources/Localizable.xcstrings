    "The microphone is in use by the system (e.g. a call). Captions resume automatically afterwards.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "النظام يستخدم الميكروفون (مثل مكالمة). ستُستأنف الترجمة تلقائيًا بعد ذلك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Mikrofon wird vom System verwendet (z. B. bei einem Anruf). Die Untertitel laufen danach automatisch weiter."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El sistema está usando el micrófono (p. ej., una llamada). Los subtítulos se reanudarán automáticamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le micro est utilisé par le système (un appel, par exemple). Les sous-titres reprendront automatiquement ensuite."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "माइक्रोफ़ोन सिस्टम के उपयोग में है (जैसे कॉल)। इसके बाद कैप्शन अपने-आप फिर शुरू होंगे।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikrofon sedang dipakai sistem (misalnya telepon). Teks akan berlanjut otomatis setelahnya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il microfono è in uso dal sistema (ad es. una chiamata). I sottotitoli riprenderanno automaticamente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システムがマイクを使用中です（通話など）。終了後、字幕は自動的に再開します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시스템이 마이크를 사용 중입니다(예: 통화). 끝나면 자막이 자동으로 다시 시작됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O microfone está sendo usado pelo sistema (por exemplo, uma ligação). As legendas voltam automaticamente depois."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Микрофон занят системой (например, звонком). Субтитры возобновятся автоматически."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikrofon sistem tarafından kullanılıyor (ör. bir arama). Altyazılar ardından otomatik olarak devam eder."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hệ thống đang dùng micrô (ví dụ cuộc gọi). Phụ đề sẽ tự tiếp tục sau đó."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "麦克风被系统占用（例如来电），结束后会自动继续。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "麥克風正被系統使用（例如來電），結束後會自動繼續。"
          }
        }
      }
    },
    "This device doesn’t support App Attest": {

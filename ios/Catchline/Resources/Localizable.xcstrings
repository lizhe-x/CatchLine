    "Microphone access is off. Turn it on in Settings → Catchline.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الوصول إلى الميكروفون متوقف. فعّله من الإعدادات ← Catchline."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikrofonzugriff ist aus. Aktiviere ihn unter Einstellungen → Catchline."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El acceso al micrófono está desactivado. Actívalo en Ajustes → Catchline."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’accès au micro est désactivé. Activez-le dans Réglages → Catchline."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "माइक्रोफ़ोन एक्सेस बंद है। सेटिंग्स → Catchline में चालू करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Akses mikrofon nonaktif. Aktifkan di Pengaturan → Catchline."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’accesso al microfono è disattivato. Attivalo in Impostazioni → Catchline."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マイクへのアクセスがオフです。設定 → Catchline でオンにしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마이크 접근이 꺼져 있습니다. 설정 → Catchline에서 켜 주세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O acesso ao microfone está desativado. Ative em Ajustes → Catchline."
          }
        },
        "ru": {

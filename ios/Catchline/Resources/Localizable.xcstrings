        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새 세션을 시작하면 현재 자막이 지워집니다"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Começar uma nova sessão apaga as legendas atuais"
          }
        },
        "ru": {

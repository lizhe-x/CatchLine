    "Call with my landlord about renewing the lease and repairs.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مكالمة مع المالك بشأن تجديد العقد والإصلاحات."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Telefonat mit meinem Vermieter über Vertragsverlängerung und Reparaturen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Llamada con mi casero sobre renovar el contrato y reparaciones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appel avec mon propriétaire au sujet du renouvellement du bail et des réparations."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मकान मालिक से लीज़ रिन्यू और मरम्मत के बारे में कॉल।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Telepon dengan pemilik rumah soal perpanjangan sewa dan perbaikan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Telefonata con il padrone di casa sul rinnovo del contratto e le riparazioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "大家さんと契約更新と修理について電話。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "집주인과 재계약 및 수리에 관해 통화."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ligação com o proprietário sobre renovação do contrato e reparos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Звонок арендодателю о продлении договора и ремонте."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ev sahibiyle kira yenileme ve tamirat hakkında görüşme."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Gọi chủ nhà về việc gia hạn hợp đồng và sửa chữa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "和房东通电话，讨论续租和维修。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "和房東通電話，討論續約和維修。"
          }
        }
      }
    },
    "Calls, meetings, conversations. Catch every word.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مكالمات واجتماعات ومحادثات. لا تفوّت أي كلمة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Telefonate, Meetings, Gespräche. Kein Wort mehr verpassen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Llamadas, reuniones, conversaciones. Entiende cada palabra."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appels, réunions, conversations. Ne manquez aucun mot."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कॉल, मीटिंग, बातचीत। हर शब्द समझें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Telepon, rapat, percakapan. Tangkap setiap kata."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiamate, riunioni, conversazioni. Non perdere una parola."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "電話も会議も会話も。一言も聞き逃さない。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "통화, 회의, 대화. 한 마디도 놓치지 마세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ligações, reuniões, conversas. Entenda cada palavra."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Звонки, встречи, разговоры. Не упустите ни слова."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aramalar, toplantılar, sohbetler. Hiçbir kelimeyi kaçırmayın."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuộc gọi, cuộc họp, trò chuyện. Không bỏ lỡ từ nào."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",

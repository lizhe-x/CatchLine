    "Names, companies, jargon. Separate with commas or new lines.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أسماء وشركات ومصطلحات. افصل بينها بفواصل أو أسطر جديدة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Namen, Firmen, Fachbegriffe. Mit Kommas oder Zeilenumbrüchen trennen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nombres, empresas, jerga. Separa con comas o saltos de línea."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Noms, entreprises, jargon. Séparez par des virgules ou des retours à la ligne."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नाम, कंपनियाँ, शब्दावली। कॉमा या नई लाइन से अलग करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Nama, perusahaan, istilah. Pisahkan dengan koma atau baris baru."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nomi, aziende, gergo. Separa con virgole o a capo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "人名、会社名、専門用語。カンマまたは改行で区切ってください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이름, 회사, 전문 용어. 쉼표나 줄바꿈으로 구분하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nomes, empresas, jargões. Separe com vírgulas ou quebras de linha."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Имена, компании, термины. Разделяйте запятыми или переносом строки."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İsimler, şirketler, terimler. Virgül veya yeni satırla ayırın."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tên người, công ty, thuật ngữ. Phân tách bằng dấu phẩy hoặc xuống dòng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "人名、公司、术语，用逗号或换行分隔。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",

  "strings": {
    "%@ hours": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 小时"
          }
        }
      }
    },
    "%@ min %@ s": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 分 %@ 秒"
          }
        }
      }
    },
    "%@/month": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@/月"
          }
        }
      }
    },
    "7 days free, then %@/month": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "前 7 天免费，之后 %@/月"
          }
        }
      }
    },
    "7-day free trial": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "7 天免费试用"
          }
        }
      }
    },
    "About %@/month, starts now": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "约 %@/月，立即生效"
          }
        }
      }
    },
    "Anonymous ID": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "匿名 ID"
          }
        }
      }
    },
    "Background (optional)": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "背景说明（可选）"
          }
        }
      }
    },
    "Call with my landlord about renewing the lease and repairs.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "和房东通电话，讨论续租和维修。"
          }
        }
      }
    },
    "Calls, meetings, conversations. Catch every word.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "电话、会议、面对面交谈，每个词都跟得上。"
          }
        }
      }
    },
    "Captions will appear here": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "字幕会显示在这里"
          }
        }
      }
    },
    "Catchline doesn’t need an account. This random ID is only used to track usage time; send it to us if you want your records deleted.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Catchline 不需要注册。这个随机 ID 只用来记录使用时长，需要删除记录时提供给我们即可。"
          }
        }
      }
    },
    "Clear and Start": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "清空并开始"
          }
        }
      }
    },

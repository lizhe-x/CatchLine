        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "实时"
          }
        }
      }
    },
    "Looks like Catchline is really helping. Go yearly and it starts right away, so you can keep going.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "看来你真的很需要 Catchline。开通年付立即生效，马上继续使用。"
          }
        }
      }
    },
    "Manage Subscription": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "管理订阅"
          }
        }
      }
    },
    "Microphone access is off. Turn it on in Settings → Catchline.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有麦克风权限。请到 设置 → Catchline 打开麦克风。"

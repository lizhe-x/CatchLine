            "state": "translated",
            "value": "Новый сеанс удалит текущие субтитры"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeni oturum başlatmak mevcut altyazıları temizler"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bắt đầu phiên mới sẽ xóa phụ đề hiện tại"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开始新会话会清空当前字幕"
          }
        },
        "zh-Hant": {

    "Catchline Pro": {
      "shouldTranslate": false
    },
    "Catchline doesn’t need an account. This random ID is only used to track usage time; send it to us if you want your records deleted.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يحتاج Catchline إلى حساب. يُستخدم هذا المعرّف العشوائي فقط لتسجيل وقت الاستخدام؛ أرسله إلينا إذا أردت حذف سجلاتك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Catchline braucht kein Konto. Diese zufällige ID dient nur zur Erfassung der Nutzungszeit. Schick sie uns, wenn deine Daten gelöscht werden sollen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Catchline no necesita cuenta. Este ID aleatorio solo sirve para registrar el tiempo de uso; envíanoslo si quieres que borremos tus datos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Catchline ne nécessite pas de compte. Cet identifiant aléatoire sert uniquement à mesurer le temps d’utilisation ; envoyez-le-nous si vous souhaitez que vos données soient supprimées."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Catchline के लिए खाते की ज़रूरत नहीं है। यह रैंडम ID सिर्फ़ इस्तेमाल का समय दर्ज करने के लिए है; अपना रिकॉर्ड हटवाना हो तो इसे हमें भेजें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Catchline tidak memerlukan akun. ID acak ini hanya untuk mencatat waktu pemakaian; kirimkan ke kami jika ingin catatanmu dihapus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Catchline non richiede un account. Questo ID casuale serve solo a registrare il tempo di utilizzo; inviacelo se vuoi che i tuoi dati vengano eliminati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Catchline はアカウント不要です。このランダムな ID は利用時間の記録にのみ使います。データの削除をご希望の場合はお知らせください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Catchline은 계정이 필요 없습니다. 이 무작위 ID는 사용 시간 기록에만 쓰이며, 기록 삭제를 원하시면 저희에게 보내 주세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Catchline não precisa de conta. Este ID aleatório serve só para registrar o tempo de uso; envie para nós se quiser que seus dados sejam apagados."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Catchline не требует аккаунта. Этот случайный ID нужен только для учёта времени использования; пришлите его нам, если хотите удалить свои данные."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Catchline hesap gerektirmez. Bu rastgele kimlik yalnızca kullanım süresini kaydetmek içindir; kayıtlarınızın silinmesini istiyorsanız bize gönderin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Catchline không cần tài khoản. ID ngẫu nhiên này chỉ dùng để ghi lại thời gian sử dụng; hãy gửi cho chúng tôi nếu bạn muốn xóa dữ liệu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Catchline 不需要注册。这个随机 ID 只用来记录使用时长，需要删除记录时提供给我们即可。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Catchline 不需要註冊。這個隨機 ID 只用來記錄使用時長，需要刪除紀錄時提供給我們即可。"
          }
        }
      }
    },
